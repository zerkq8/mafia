# انسخ هذا الملف باسم .env.local محليًا، وأضف نفس القيم في Vercel → Environment Variables

# من Supabase → Settings → General
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co

# من Supabase → Settings → API Keys → Publishable key (آمن للمتصفح)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# من Supabase → Settings → API Keys → Secret keys (⚠️ سري جدًا — Server-side فقط، لا تضعه Public في Vercel)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
